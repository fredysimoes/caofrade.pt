# ====================================================================
# Configurações do Agente de Publicação Instagram da Cãofrade.pt
# ====================================================================
# Copia este ficheiro para .env ou preenche as variáveis de ambiente

# 1. ID da Conta de Instagram Business/Creator (Obtido via Graph API Explorer)
INSTAGRAM_ACCOUNT_ID=

# 2. Token de Acesso de Longa Duração (60 dias) ou Token Permanente de Sistema
INSTAGRAM_ACCESS_TOKEN=

# 3. Domínio Base para converter caminhos relativos de imagens em URLs públicos
# A API do Instagram exige URLs públicos acessíveis via HTTPS
BASE_IMAGE_URL=https://www.caofrade.pt

# 4. Modo de Segurança (true = não publica na API, apenas simula e grava rascunho)
# Altera para false quando tiveres as credenciais configuradas
DRY_RUN=true

# 5. Parâmetros de Marketing da Marca
BRAND_NAME=Cãofrade.pt
BRAND_HANDLE=@caofrade.pt
DISCOUNT_CODE=CAOFRADE10
FREE_SHIPPING_MIN=39.90
WEBSITE_URL=https://www.caofrade.pt
